{
  "compilerOptions": {
    "target": "ES2020", "lib": ["dom", "esnext"], "strict": true, "noEmit": true,
    "module": "esnext", "moduleResolution": "bundler", "jsx": "preserve",
    "resolveJsonModule": true, "isolatedModules": true, "esModuleInterop": true,
    "skipLibCheck": true, "baseUrl": ".", "paths": { "@/*": ["./*"] }, "allowJs": false, "incremental": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
